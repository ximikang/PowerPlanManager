<Window
    x:Class="PowerManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="48" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="20" />
                <TextBlock x:Uid="Main_Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="920" Padding="32,20,32,48" Spacing="20" HorizontalAlignment="Stretch">
                <TextBlock x:Uid="Main_Subtitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock x:Uid="CurrentPlanLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="CurrentPlanText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="NextSwitchText" Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoSwitchToggle" x:Uid="AutoSwitchToggle" Grid.Column="1" Toggled="AutoSwitchToggle_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Uid="QuickTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PowerSaverButton" x:Uid="PowerSaverButton" Tag="PowerSaver" Click="QuickSlotButton_Click" HorizontalAlignment="Stretch" Padding="12" />
                    <Button x:Name="BalancedButton" x:Uid="BalancedButton" Tag="Balanced" Click="QuickSlotButton_Click" Grid.Column="1" HorizontalAlignment="Stretch" Padding="12" />
                    <Button x:Name="HighPerformanceButton" x:Uid="HighPerformanceButton" Tag="HighPerformance" Click="QuickSlotButton_Click" Grid.Column="2" HorizontalAlignment="Stretch" Padding="12" />
                    <Button x:Name="UltimatePerformanceButton" x:Uid="UltimatePerformanceButton" Tag="UltimatePerformance" Click="QuickSlotButton_Click" Grid.Column="3" HorizontalAlignment="Stretch" Padding="12" />
                </Grid>

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="MappingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <Grid RowSpacing="10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="PowerSaverMappingLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="PowerSaverMapping" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            <TextBlock x:Uid="BalancedMappingLabel" Grid.Row="1" VerticalAlignment="Center" />
                            <ComboBox x:Name="BalancedMapping" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            <TextBlock x:Uid="HighPerformanceMappingLabel" Grid.Row="2" VerticalAlignment="Center" />
                            <ComboBox x:Name="HighPerformanceMapping" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            <TextBlock x:Uid="UltimatePerformanceMappingLabel" Grid.Row="3" VerticalAlignment="Center" />
                            <ComboBox x:Name="UltimatePerformanceMapping" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            <TextBlock x:Uid="DefaultPlanLabel" Grid.Row="4" VerticalAlignment="Center" />
                            <ComboBox x:Name="DefaultSlotCombo" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="SaveMappingsButton" x:Uid="SaveMappingsButton" Click="SaveMappingsButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="CreateMissingButton" x:Uid="CreateMissingButton" Click="CreateMissingButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ScheduleTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Uid="ScheduleHint" Opacity="0.72" TextWrapping="Wrap" />
                        <StackPanel x:Name="ScheduleTimelinePanel" Spacing="7">
                            <TextBlock x:Uid="TimelineTitle" FontWeight="SemiBold" />
                            <Border Height="38" CornerRadius="7" Background="#206B7280">
                                <Canvas x:Name="ScheduleTimelineCanvas" SizeChanged="ScheduleTimelineCanvas_SizeChanged" />
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="00:00" FontSize="11" Opacity="0.65" />
                                <TextBlock Text="06:00" Grid.Column="1" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                                <TextBlock Text="12:00" Grid.Column="2" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                                <TextBlock Text="18:00" Grid.Column="3" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" />
                                <TextBlock Text="24:00" Grid.Column="4" FontSize="11" Opacity="0.65" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#2DA44E" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="PowerSaverMappingLabel" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#2583E0" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="BalancedMappingLabel" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#F08C2E" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="HighPerformanceMappingLabel" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#9B59B6" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="UltimatePerformanceMappingLabel" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="StartTimeLabel" />
                                <ComboBox x:Name="StartTimeCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="EndTimeLabel" />
                                <ComboBox x:Name="EndTimeCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock x:Uid="TargetSlotLabel" />
                                <ComboBox x:Name="RuleTargetCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Name" />
                            </StackPanel>
                            <Button x:Name="AddRuleButton" x:Uid="AddRuleButton" Grid.Column="3" Click="AddRuleButton_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <ListView x:Name="ScheduleList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartText}" VerticalAlignment="Center" />
                                        <TextBlock Text="→" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EndText}" Grid.Column="2" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TargetName}" Grid.Column="3" VerticalAlignment="Center" />
                                        <Button x:Uid="DeleteRuleButton" Grid.Column="4" Tag="{Binding Id}" Click="DeleteRuleButton_Click">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="GeneralTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <ToggleSwitch x:Name="StartupToggle" x:Uid="StartupToggle" Toggled="StartupToggle_Toggled" />
                        <ToggleSwitch x:Name="NotificationsToggle" x:Uid="NotificationsToggle" Toggled="NotificationsToggle_Toggled" />
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="LanguageLabel" />
                            <ComboBox x:Name="LanguageCombo" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="LanguageCombo_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="DiagnosticsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" TextWrapping="Wrap" />
                        <Button x:Name="RefreshButton" x:Uid="RefreshButton" Click="RefreshButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
